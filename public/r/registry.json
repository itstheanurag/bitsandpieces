{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "bitsandpieces",
  "homepage": "https://itstheanurag.github.io/bitsandpieces",
  "items": [
    {
      "name": "animated-form",
      "type": "registry:block",
      "title": "Animated Form",
      "description": "A beautiful account creation form with progressive steps and smooth transitions.",
      "dependencies": ["framer-motion", "clsx", "tailwind-merge"],
      "files": [
        {
          "path": "registry/bitsandpieces/forms/animated-form.tsx",
          "type": "registry:component",
          "target": "components/bitsandpieces/animated-form.tsx"
        },
        {
          "path": "registry/bitsandpieces/lib/utils.ts",
          "type": "registry:lib",
          "target": "lib/utils.ts"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Side Depth Button",
      "description": "A tactile button that mimics physical depth using complex shadows and transforms.",
      "dependencies": [
        "clsx",
        "tailwind-merge",
        "class-variance-authority",
        "@radix-ui/react-slot"
      ],
      "files": [
        {
          "path": "registry/bitsandpieces/buttons/button.tsx",
          "type": "registry:component",
          "target": "components/bitsandpieces/button.tsx"
        },
        {
          "path": "registry/bitsandpieces/lib/utils.ts",
          "type": "registry:lib",
          "target": "lib/utils.ts"
        }
      ]
    }
  ]
}
